# Ordinary confirmed users in a dedicated Supabase test project.
# Copy to ignored .env.e2e.local; never use pilot or production accounts.
ALLOW_TEST_DATA_WRITES=1
E2E_USER_ONE_EMAIL=
E2E_USER_ONE_PASSWORD=
E2E_USER_TWO_EMAIL=
E2E_USER_TWO_PASSWORD=
# Optional deployed test app using the same Supabase test project:
# E2E_BASE_URL=https://your-test-app.example
